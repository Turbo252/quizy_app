<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/btn_theme"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_agenda"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_rules_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="Правила игры"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="32dp"
        app:layout_constraintBottom_toTopOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_rules_title">

        <TextView
            android:id="@+id/tv_rules_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добро пожаловать в Quizy!\n\n1. Выберите уровень сложности на главном экране перед началом.\n\n2. Каждая игровая сессия состоит из 10 вопросов.\n\n3. На каждый вопрос дается 4 варианта ответа, и только один из них правильный.\n\n4. Старайтесь отвечать не только правильно, но и быстро — таймер ставится на паузу между вопросами, а приложение сохраняет ваш рекорд по скорости прохождения 10 вопросов!\n\n5. После каждых 10 вопросов вы можете посмотреть свою статистику, а затем либо продолжить серию, либо выйти в главное меню.\n\n6. При досрочном выходе из игры через крестик, прогресс текущего блока не сохраняется.\n\nУдачи и новых рекордов!"
            android:textSize="20sp" />
    </ScrollView>

    <Button
        android:id="@+id/btn_back"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:text="В ГЛАВНОЕ МЕНЮ"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>