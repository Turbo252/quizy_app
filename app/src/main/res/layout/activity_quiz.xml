<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="-117dp">

        <TextView
            android:id="@+id/textView_questionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Question 1 of 5"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:text="Question"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView_questionCount" />

        <Button
            android:id="@+id/btn_answer1"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="128dp"
            android:text="answer1"
            app:layout_constraintTop_toBottomOf="@+id/textView_question"
            tools:layout_editor_absoluteX="85dp" />

        <Button
            android:id="@+id/btn_answer2"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="answer2"
            app:layout_constraintTop_toBottomOf="@+id/btn_answer1"
            tools:layout_editor_absoluteX="85dp" />

        <Button
            android:id="@+id/btn_answer3"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="answer3"
            app:layout_constraintTop_toBottomOf="@+id/btn_answer2"
            tools:layout_editor_absoluteX="85dp" />

        <Button
            android:id="@+id/btn_answer4"
            android:layout_width="240dp"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="answer4"
            app:layout_constraintTop_toBottomOf="@+id/btn_answer3"
            tools:layout_editor_absoluteX="85dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
